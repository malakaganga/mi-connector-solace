{
  "connectorName": "solace",
  "connectionName": "solace",
  "title": "Solace Connection",
  "help": "Configuration properties for Solace connection",
  "elements": [
    {
      "type": "attribute",
      "value": {
        "name": "connectionName",
        "displayName": "Connection Name",
        "inputType": "string",
        "defaultValue": "solace_CONNECTION_1",
        "required": "true",
        "helpTip": "The name for the Solace connection.",
        "validation": "nameWithoutSpecialCharacters"
      }
    },
    {
      "type": "attribute",
      "value": {
          "name": "host",
          "displayName": "Host URL",
          "inputType": "string",
          "defaultValue": "tcp://localhost:55555",
          "required": "true",
          "helpTip": "The host URL for the Solace broker (e.g., tcp://localhost:55555 or tcps://broker.example.com:55443 for SSL)."
      }
    },
    {
      "type": "attribute",
      "value": {
          "name": "vpnName",
          "displayName": "VPN Name",
          "inputType": "string",
          "defaultValue": "default",
          "required": "true",
          "helpTip": "Message VPN name."
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "General",
        "elements": [
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Authentication",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "authenticationScheme",
                    "displayName": "Authentication Scheme",
                    "inputType": "combo",
                    "comboValues": ["BASIC", "CLIENT_CERTIFICATE", "OAUTH2"],
                    "defaultValue": "BASIC",
                    "required": "false",
                    "helpTip": "How the broker authenticates this connection. BASIC uses username/password (default). CLIENT_CERTIFICATE uses the configured key store as the credential — broker derives the username from the cert CN. OAUTH2 uses an access token (and optionally an OIDC ID token / issuer identifier)."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "username",
                    "displayName": "Username",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "true",
                    "helpTip": "The username for authenticating with the Solace broker.",
                    "enableCondition": [
                      {"authenticationScheme": "BASIC"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "apiProvidedUsername",
                    "displayName": "API-Provided Username",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Optional. Used only when the Message VPN is configured with 'allow-api-provided-username'. For CLIENT_CERTIFICATE auth, leave blank to use the certificate's Common Name (default broker behavior). For OAUTH2, leave blank — identity comes from the token.",
                    "enableCondition": [
                      {"authenticationScheme": "CLIENT_CERTIFICATE"},
                      {"authenticationScheme": "OAUTH2"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "password",
                    "displayName": "Password",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "true",
                    "helpTip": "The password for authenticating with the Solace broker.",
                    "enableCondition": [
                      {"authenticationScheme": "BASIC"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "oauth2AccessToken",
                    "displayName": "OAuth2 Access Token",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "OAuth2 access token used to authenticate with the broker. Provide either this, an OIDC ID token, or both. The broker validates the token against its configured OAuth profile.",
                    "enableCondition": [
                      {"authenticationScheme": "OAUTH2"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "oidcIdToken",
                    "displayName": "OIDC ID Token",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Optional OIDC ID token. Used in the OAuth client-role profile. Provide either this, an access token, or both.",
                    "enableCondition": [
                      {"authenticationScheme": "OAUTH2"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "oauth2IssuerIdentifier",
                    "displayName": "OAuth2 Issuer Identifier",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Optional issuer URI used to disambiguate when the broker has multiple OAuth profiles and the issuer can't be derived from the token. Leave blank for single-profile setups.",
                    "enableCondition": [
                      {"authenticationScheme": "OAUTH2"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "clientName",
                    "displayName": "Client Name",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Client name prefix. Each session of this connection appends the node, the connection name and a role suffix. Set clientNameStrict to send the name as given."
                  }
                }
              ]
            }
          },
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Connection Settings",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "connectionTimeout",
                    "displayName": "Connection Timeout (ms)",
                    "inputType": "string",
                    "defaultValue": "30000",
                    "required": "false",
                    "helpTip": "Connection timeout in milliseconds."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "readTimeout",
                    "displayName": "Read Timeout (ms)",
                    "inputType": "string",
                    "defaultValue": "10000",
                    "required": "false",
                    "helpTip": "Read timeout in milliseconds."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "connectRetries",
                    "displayName": "Connect Retries",
                    "inputType": "string",
                    "defaultValue": "3",
                    "required": "false",
                    "helpTip": "Number of connection retry attempts."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "connectRetriesPerHost",
                    "displayName": "Connect Retries Per Host",
                    "inputType": "string",
                    "defaultValue": "0",
                    "required": "false",
                    "helpTip": "Number of connection retries per host."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "reconnectRetries",
                    "displayName": "Reconnect Retries",
                    "inputType": "string",
                    "defaultValue": "3",
                    "required": "false",
                    "helpTip": "Number of reconnection retry attempts."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "reconnectRetryWait",
                    "displayName": "Reconnect Retry Wait (ms)",
                    "inputType": "string",
                    "defaultValue": "3000",
                    "required": "false",
                    "helpTip": "Wait time between reconnection retries in milliseconds."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "compressionLevel",
                    "displayName": "Compression Level",
                    "inputType": "string",
                    "defaultValue": "0",
                    "required": "false",
                    "helpTip": "Compression level (0-9). 0 disables compression."
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "SSL/TLS Security",
        "elements": [
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Trust Store (Server Authentication)",
              "isCollapsed": true,
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslTrustStorePath",
                    "displayName": "Trust Store Path",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Path to the SSL trust store file containing CA certificates for broker validation."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslTrustStorePassword",
                    "displayName": "Trust Store Password",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Password for the SSL trust store."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslTrustStoreFormat",
                    "displayName": "Trust Store Format",
                    "inputType": "string",
                    "defaultValue": "JKS",
                    "required": "false",
                    "helpTip": "Format of the SSL trust store (e.g., JKS, PKCS12)."
                  }
                }
              ]
            }
          },
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Key Store (Client Authentication)",
              "isCollapsed": true,
              "enableCondition": [
                {"authenticationScheme": "CLIENT_CERTIFICATE"}
              ],
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslKeyStorePath",
                    "displayName": "Key Store Path",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Path to the SSL key store file containing client certificates for mutual TLS."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslKeyStorePassword",
                    "displayName": "Key Store Password",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Password for the SSL key store."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslKeyStoreFormat",
                    "displayName": "Key Store Format",
                    "inputType": "string",
                    "defaultValue": "JKS",
                    "required": "false",
                    "helpTip": "Format of the SSL key store (e.g., JKS, PKCS12)."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslKeyPassword",
                    "displayName": "Private Key Password",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Password for the SSL private key."
                  }
                }
              ]
            }
          },
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Certificate Validation",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslValidateCertificate",
                    "displayName": "Validate Certificate",
                    "inputType": "boolean",
                    "defaultValue": true,
                    "required": "false",
                    "helpTip": "Whether to validate the broker's TLS certificate against the trust store. Keep this enabled. Disabling it turns off certificate verification and exposes the connection to man-in-the-middle attacks — not recommended for production."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslValidateCertificateDate",
                    "displayName": "Validate Certificate Date",
                    "inputType": "boolean",
                    "defaultValue": true,
                    "required": "false",
                    "helpTip": "Whether to validate the certificate expiration date. Keep this enabled; disabling it allows expired certificates and is not recommended for production.",
                    "enableCondition": [
                      {"sslValidateCertificate": "true"}
                    ]
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "sslValidateHostname",
                    "displayName": "Validate Certificate Hostname",
                    "inputType": "boolean",
                    "defaultValue": true,
                    "required": "false",
                    "helpTip": "Whether to verify that the broker's certificate matches the host being connected to. Keep this enabled. Disabling it allows a valid certificate issued for a different host to be accepted, defeating man-in-the-middle protection — not recommended for production.",
                    "enableCondition": [
                      {"sslValidateCertificate": "true"}
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Advanced Message Options",
        "isCollapsed": true,
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "generateSendTimestamps",
              "displayName": "Generate Send Timestamps",
              "inputType": "boolean",
              "defaultValue": false,
              "required": "false",
              "helpTip": "Whether to automatically generate send timestamps on messages."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "generateSequenceNumbers",
              "displayName": "Generate Sequence Numbers",
              "inputType": "boolean",
              "defaultValue": false,
              "required": "false",
              "helpTip": "Whether to automatically generate sequence numbers on messages."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "calculateMessageExpiration",
              "displayName": "Calculate Message Expiration",
              "inputType": "boolean",
              "defaultValue": false,
              "required": "false",
              "helpTip": "Whether to calculate message expiration based on TTL."
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Reliability",
        "isCollapsed": true,
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "pollAckTimeout",
              "displayName": "Poll Ack Timeout (ms)",
              "inputType": "string",
              "defaultValue": "180000",
              "required": "false",
              "helpTip": "Lease of a message polled with ackMode=CLIENT. When it passes unsettled, the connector settles the message FAILED and the broker redelivers it."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "pollFlowIdleTimeout",
              "displayName": "Poll Flow Idle Timeout (ms)",
              "inputType": "string",
              "defaultValue": "60000",
              "required": "false",
              "helpTip": "An idle poll flow with no outstanding lease is closed after this time."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxPollFlows",
              "displayName": "Max Poll Flows",
              "inputType": "string",
              "defaultValue": "16",
              "required": "false",
              "helpTip": "Poll flows cached per connection, one per queue and selector, each with its own owner thread. Beyond it the least recently used idle flow is evicted, and when none is idle the poll faults with POLL_FLOW_LIMIT."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "requireSettlementOutcomes",
              "displayName": "Require Settlement Outcomes",
              "inputType": "combo",
              "comboValues": ["AUTO", "TRUE"],
              "defaultValue": "AUTO",
              "required": "false",
              "helpTip": "AUTO requests the settlement outcomes the broker reports and, for a missing one, retains the message and recycles its flow so the broker redelivers it. TRUE fails the poll flow bind when the broker lacks FAILED or REJECTED."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxConcurrentRequests",
              "displayName": "Max Concurrent Requests",
              "inputType": "string",
              "defaultValue": "100",
              "required": "false",
              "helpTip": "Concurrent sendRequest calls on the connection's request reply session. A call beyond it waits up to its requestTimeout and then faults with REQUEST_CONCURRENCY_EXCEEDED."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "recovery.initialDelay",
              "displayName": "Recovery Initial Delay (ms)",
              "inputType": "string",
              "defaultValue": "1000",
              "required": "false",
              "helpTip": "First delay before a failed session is rebuilt."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "recovery.progression",
              "displayName": "Recovery Progression",
              "inputType": "string",
              "defaultValue": "2.0",
              "required": "false",
              "helpTip": "Multiplier applied to the delay after each failed rebuild attempt."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "recovery.maxDelay",
              "displayName": "Recovery Max Delay (ms)",
              "inputType": "string",
              "defaultValue": "60000",
              "required": "false",
              "helpTip": "Upper bound of the rebuild delay."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "recovery.maxAttempts",
              "displayName": "Recovery Max Attempts",
              "inputType": "string",
              "defaultValue": "-1",
              "required": "false",
              "helpTip": "Rebuild attempts before the operation faults. -1 means unlimited within the operation's deadline."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "clientNameStrict",
              "displayName": "Client Name Strict",
              "inputType": "boolean",
              "defaultValue": false,
              "required": "false",
              "helpTip": "When enabled the Client Name is sent as given to the first pooled session and the other sessions append their role. When disabled every session name is the Client Name prefix followed by the node id, the connection name and the session's role."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "oauth2TokenFile",
              "displayName": "OAuth2 Token File",
              "inputType": "string",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Path of a file holding the OAuth2 access token. The token is read from the file at every connect and reconnect, so a sidecar can rotate it. Requires the OAUTH2 authentication scheme.",
              "enableCondition": [
                {"authenticationScheme": "OAUTH2"}
              ]
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "keepAliveInterval",
              "displayName": "Keep Alive Interval (ms)",
              "inputType": "string",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Keep alive interval of the JCSMP sessions. Empty leaves the JCSMP default."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "keepAliveLimit",
              "displayName": "Keep Alive Limit",
              "inputType": "string",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Missed keep alive responses after which a JCSMP session is considered lost. Empty leaves the JCSMP default."
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Pool",
        "isCollapsed": true,
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "maxActiveConnections",
              "displayName": "Max Active Connections",
              "inputType": "string",
              "defaultValue": "8",
              "required": "false",
              "helpTip": "Maximum number of pooled sessions."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxIdleConnections",
              "displayName": "Max Idle Connections",
              "inputType": "string",
              "defaultValue": "8",
              "required": "false",
              "helpTip": "Maximum number of idle pooled sessions kept."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxWaitTime",
              "displayName": "Max Wait Time (ms)",
              "inputType": "string",
              "defaultValue": "10000",
              "required": "false",
              "helpTip": "Time an operation waits for a pooled session before it faults. Zero or a negative value is replaced by 10000, because the pool would wait forever."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "minEvictionTime",
              "displayName": "Min Eviction Time (ms)",
              "inputType": "string",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Time a pooled session may stay idle before the evictor may close it. Empty leaves the pool default."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "evictionCheckInterval",
              "displayName": "Eviction Check Interval (ms)",
              "inputType": "string",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Interval between runs of the pool evictor. Empty leaves the evictor off."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "exhaustedAction",
              "displayName": "Exhausted Action",
              "inputType": "combo",
              "comboValues": ["WHEN_EXHAUSTED_BLOCK", "WHEN_EXHAUSTED_FAIL", "WHEN_EXHAUSTED_GROW"],
              "defaultValue": "WHEN_EXHAUSTED_BLOCK",
              "required": "false",
              "helpTip": "What a borrow does when every pooled session is in use. WHEN_EXHAUSTED_BLOCK waits up to Max Wait Time, WHEN_EXHAUSTED_FAIL faults at once, WHEN_EXHAUSTED_GROW creates one more session."
            }
          }
        ]
      }
    }
  ]
}
