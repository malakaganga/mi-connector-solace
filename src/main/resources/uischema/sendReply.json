{
  "connectorName": "solace",
  "operationName": "sendReply",
  "title": "Send Reply",
  "help": "Send a reply to an inbound request message using the reply-to destination from the message context",
  "elements": [
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "General",
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "configRef",
              "displayName": "Connection",
              "inputType": "connection",
              "allowedConnectionTypes": ["solace"],
              "defaultType": "connection.solace",
              "defaultValue": "",
              "required": "true",
              "helpTip": "The connection to use for the operation."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "target",
              "displayName": "Target",
              "inputType": "combo",
              "comboValues": ["INBOUND", "POLL"],
              "defaultValue": "INBOUND",
              "required": "false",
              "helpTip": "INBOUND replies to the message the inbound endpoint stashed. POLL replies to the message stashed by a poll with ackMode=CLIENT."
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Advanced",
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "deliveryMode",
              "displayName": "Delivery Mode",
              "inputType": "combo",
              "defaultValue": "DIRECT",
              "comboValues": [
                "DIRECT",
                "PERSISTENT",
                "NON_PERSISTENT"
              ],
              "helpTip": "Delivery mode: DIRECT, PERSISTENT, or NON_PERSISTENT."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "waitForAck",
              "displayName": "Wait For Ack",
              "inputType": "boolean",
              "defaultValue": true,
              "helpTip": "Wait for the broker acknowledgement of a PERSISTENT or NON_PERSISTENT reply before returning. Ignored for DIRECT.",
              "enableCondition": [
                "NOT",
                {
                  "deliveryMode": "DIRECT"
                }
              ]
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "ackTimeout",
              "displayName": "Ack Timeout",
              "inputType": "stringOrExpression",
              "defaultValue": "10000",
              "helpTip": "Deadline in milliseconds for the connect, the send and the broker acknowledgement of the reply.",
              "enableCondition": [
                "NOT",
                {
                  "deliveryMode": "DIRECT"
                }
              ]
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "messageType",
              "displayName": "Message Type",
              "inputType": "combo",
              "defaultValue": "TEXT",
              "comboValues": [
                "TEXT",
                "BYTES",
                "XML"
              ],
              "helpTip": "Message type: TEXT, BYTES, or XML. JSON payloads are auto-detected and carried as TEXT."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "applicationMessageType",
              "displayName": "Application Message Type",
              "inputType": "stringOrExpression",
              "defaultValue": "",
              "helpTip": "Application-defined message type."
            }
          },
          {
            "type": "table",
            "value": {
              "name": "userProperties",
              "displayName": "User Properties",
              "description": "User properties as a JSON array of objects, for example [{\"region\":\"US\"},{\"priority\":\"high\"}]. Every key of every object is a property. A string stays a string, an integer becomes a long, a decimal a double and a boolean a boolean. A receiver reads each one as the attribute userProp_ followed by the key, for example ${vars.result.attributes.userProp_region}.",
              "tableKey": "propertyName",
              "tableValue": "propertyValue",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "propertyName",
                    "displayName": "Name",
                    "inputType": "string",
                    "required": false,
                    "helpTip": "The property key, sent unchanged. A receiver reads it as the attribute userProp_ followed by this key."
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "propertyValue",
                    "displayName": "Value",
                    "inputType": "stringOrExpression",
                    "required": false,
                    "helpTip": "The property value. The table is sent as a JSON array of objects, one key per object. A string stays a string, an integer becomes a long, a decimal a double and a boolean a boolean."
                  }
                }
              ]
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "responseVariable",
              "displayName": "Response Variable",
              "inputType": "stringOrExpression",
              "defaultValue": "solaceResponse",
              "helpTip": "The name of the variable to which the output should be stored."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "overwriteBody",
              "displayName": "Overwrite Body",
              "inputType": "boolean",
              "defaultValue": false,
              "hidden": true,
              "helpTip": "Replace the Message Body in Message Context with the response."
            }
          }
        ]
      }
    }
  ]
}
